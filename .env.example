# CareerCopilot 根目录环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 这些变量被 docker-compose.yml 读取；全部有开发默认值，本地可以不建 .env 直接启动。

# ---------- PostgreSQL (pgvector/pgvector:pg16) ----------
# 数据库名
POSTGRES_DB=careercopilot
# 数据库用户
POSTGRES_USER=careercopilot
# 数据库密码（仅开发默认值，云端部署必须修改）
POSTGRES_PASSWORD=careercopilot_dev
# 宿主机映射端口
POSTGRES_PORT=55432  # 本机 5432 被 Homebrew postgresql@16（税务项目）占用

# ---------- Redis (redis:7-alpine) ----------
# 留空 = 开发环境无密码；非空则自动启用 requirepass
REDIS_PASSWORD=
# 宿主机映射端口
REDIS_PORT=56379  # 本机 6379 被 ssh 隧道占用

# ---------- Mailpit（本地 SMTP 捕获 + Web UI） ----------
# SMTP 端口（后端发信指向 localhost:1025）
MAILPIT_SMTP_PORT=1025
# Web UI 端口（浏览器访问 http://localhost:8025 查看邮件）
MAILPIT_UI_PORT=8025
