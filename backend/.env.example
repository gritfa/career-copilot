# CareerCopilot backend 环境变量示例。
# 复制为 .env 并按本地环境修改；.env 不要提交到版本库。

APP_NAME=careercopilot-backend
ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL + pgvector（asyncpg 驱动；Alembic 自动换用 psycopg）
DATABASE_URL=postgresql+asyncpg://careercopilot:careercopilot_dev@localhost:55432/careercopilot

# Redis（Celery broker / 缓存）
REDIS_URL=redis://localhost:56379/0

# 健康检查探测外部依赖的超时（秒）
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# 哈希 pepper（邀请码/邮箱哈希/IP 哈希）。生产必须换成强随机值；
# 更换后已发放邀请码将失效。
SECRET_PEPPER=dev-only-pepper

# SMTP（本地开发 = Mailpit；Web UI http://localhost:8025）
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@careercopilot.local

# magic link（验证链接指向前端；15 分钟单次有效）
FRONTEND_BASE_URL=http://localhost:3000
MAGIC_LINK_TTL_SECONDS=900
MAGIC_LINK_RATE_LIMIT_PER_EMAIL=3
MAGIC_LINK_RATE_LIMIT_PER_IP=10
MAGIC_LINK_RATE_WINDOW_SECONDS=900

# 会话（管理员更短）
SESSION_COOKIE_NAME=cc_session
SESSION_TTL_SECONDS=2592000
ADMIN_SESSION_TTL_SECONDS=43200

# 账号注销恢复期（天）
ACCOUNT_DELETION_GRACE_DAYS=7

# ---------- 阶段 3：简历上传 / 解析 ----------
STORAGE_BACKEND=local
STORAGE_DIR=var/storage
RESUME_MAX_SIZE_BYTES=10485760
RESUME_MAX_PAGES=30
PARSE_TIMEOUT_SECONDS=30
CELERY_TASK_ALWAYS_EAGER=0

# ---------- 阶段 5：Embedding / 匹配 ----------
# 阿里云百炼（DashScope）API key：为空时使用确定性合成 Embedding，
# aliyun_embedding 能力保持 not_verified
DASHSCOPE_API_KEY=
EMBEDDING_MODEL_ID=text-embedding-v3
RECALL_TOP_K=50
DAILY_RECOMMENDATION_LIMIT=20

# ---------- 阶段 6：Model Gateway / 标准分析 ----------
# DeepSeek API key：为空时使用确定性合成分析 Adapter，
# deepseek_generation / standard_analysis 能力保持 not_verified；
# 真实 key 一填即切换到真实 DeepSeekAdapter
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_ID=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 每账号每日手动深度分析次数（自动触发按 ADR-001 推迟）
ANALYSIS_MANUAL_DAILY_LIMIT=3
